# Copiar a .env.local (no versionado) y completar con los valores del proyecto
# Supabase (Project Settings → API).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key: NUNCA exponer al cliente. Solo se usa en lib/supabase/admin.ts
# (scripts/seed.ts y rutas server-side que lo requieran explícitamente).
SUPABASE_SERVICE_ROLE_KEY=

# Fase 3 — Gmail OAuth (ver README para cómo generarlas en Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Cualquier string largo y random sirve (se usa para cifrar los tokens en la
# tabla gmail_tokens). Generar uno con: openssl rand -base64 32
GMAIL_TOKEN_ENCRYPTION_KEY=

# Fase 4 — protege /api/cron/weekly-report para que solo Vercel Cron pueda
# dispararlo. Generar uno con: openssl rand -base64 32
# En Vercel: Project Settings → Environment Variables → CRON_SECRET (mismo
# valor). Vercel lo manda solo en el header Authorization de sus cron jobs.
CRON_SECRET=
