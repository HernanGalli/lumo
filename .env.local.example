# Copiar a .env.local (no versionado) y completar con los valores del proyecto
# Supabase (Project Settings → API).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key: NUNCA exponer al cliente. Solo se usa en lib/supabase/admin.ts
# (scripts/seed.ts y rutas server-side que lo requieran explícitamente).
SUPABASE_SERVICE_ROLE_KEY=

# Fase 3 (Gmail OAuth) — se completa más adelante
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_TOKEN_ENCRYPTION_KEY=
